# B.AI API key
BAI_API_KEY=your_bai_api_key_here
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=mimo-v2.5

# Weatherstack API key (for weather queries)
WEATHERSTACK_API_KEY=your_weatherstack_api_key_here

# Calendarific API key (for holiday queries)
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Optional realtime TTS (Supertonic 3)
TTS_ENABLED=true
SUPERTONIC_HOST=127.0.0.1
SUPERTONIC_PORT=7788
SUPERTONIC_VOICE=F1
SUPERTONIC_LANG=id
SUPERTONIC_STEPS=8
SUPERTONIC_SPEED=1.05