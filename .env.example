# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Weatherstack API key (for weather queries)
WEATHERSTACK_API_KEY=your_weatherstack_api_key_here

# Calendarific API key (for holiday queries)
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Optional realtime Kokoro TTS
TTS_ENABLED=false
KOKORO_TTS_SERVER_URL=http://127.0.0.1:5005
TTS_FALLBACK_TO_TEXT_ONLY=true
